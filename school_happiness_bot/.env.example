BOT_TOKEN=your_telegram_bot_token_here
ADMIN_CHAT_ID=
# Путь к файлу SQLite. Оставьте пустым для локального запуска
# (файл создастся рядом, в contacts.db). На Railway с подключённым
# Volume укажите /data/contacts.db.
DB_PATH=
# Ключ OpenRouter (https://openrouter.ai/keys) для классификации обращений
# и разбора имени через ИИ. Если оставить пустым, бот работает по-старому:
# категория помощи выбирается только кнопками, а имя берётся как есть.
OPENROUTER_API_KEY=
# Модель на OpenRouter — дешёвая и быстрая, для структурной задачи хватает.
# По умолчанию используется openai/gpt-4o-mini, если не задано.
OPENROUTER_MODEL=openai/gpt-4o-mini
